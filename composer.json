{
    "name": "dolalima/boletosimples",
    "type": "library",
    "version": "1.2.0",
    "description": "A PHP client library for easily accessing Boleto Simples API.",
    "keywords": [
        "boleto",
        "simples",
        "boletosimples",
        "ecommerce"
    ],
    "homepage": "http://api.kobana.com.br",
    "license": "MIT",
    "authors": [
        {
            "name": "Rafael Lima",
            "email": "contato@rafael.adm.br",
            "homepage": "http://rafael.adm.br/"
        }
    ],
    "support": {
        "email": "suporte@kobana.com.br",
        "issues": "http://github.com/BoletoSimples/boletosimples-php/issues",
        "sources": "https://github.com/BoletoSimples/boletosimples-php"
    },
    "require": {
        "php": ">=7.0",
        "guzzlehttp/guzzle": "^6.3 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^6.0 || ^7.0 || ^8.0",
        "php-vcr/php-vcr": "^1.4",
        "php-vcr/phpunit-testlistener-vcr": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "BoletoSimples\\": [
                "src/BoletoSimples",
                "src/BoletoSimples/Resources"
            ]
        },
        "files": [
            "src/BoletoSimples.php"
        ]
    }
}